        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Number of listings&quot; THEN COUNTD([id])&#13;&#10;WHEN &quot;Occupancy rate (%)&quot; THEN ROUND(AVG([Calculation_1000000000000001]) * 100, 1)&#13;&#10;WHEN &quot;Average rating&quot; THEN ROUND(AVG([review_scores_rating]), 2)&#13;&#10;WHEN &quot;Reviews, last 12 months&quot; THEN SUM([number_of_reviews_ltm])&#13;&#10;END' />
      </column>
            <column-instance column='[neighbourhood_cleansed]' derivation='None' name='[none:neighbourhood_cleansed:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1000000000000005]' derivation='User' name='[usr:Calculation_1000000000000005:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <shelf-sorts>
            <shelf-sort-v2 dimension-to-sort='[federated.0g9ytm80t4qxlq14nvp8c0jfyqb4].[none:neighbourhood_cleansed:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.0g9ytm80t4qxlq14nvp8c0jfyqb4].[usr:Calculation_1000000000000005:qk]' shelf='rows' />
          </shelf-sorts>
          <aggregation value='true' />
        </view>
