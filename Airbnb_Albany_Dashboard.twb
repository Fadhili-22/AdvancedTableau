      <aliases enabled='yes' />
      <column caption='Occupancy Rate' datatype='real' default-format='p0.0%' name='[Calculation_1000000000000001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[estimated_occupancy_l365d] / 365' />
      </column>
      <column caption='Host Type' datatype='string' name='[Calculation_1000000000000002]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [host_is_superhost] THEN &quot;Superhost&quot; ELSE &quot;Regular host&quot; END' />
      </column>
      <column caption='Superhost Share' datatype='real' default-format='p0.0%' name='[Calculation_1000000000000003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [host_is_superhost] THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Average Rating' datatype='real' name='[Calculation_1000000000000004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(AVG([review_scores_rating]), 2)' />
      </column>
      <column caption='Selected Metric' datatype='real' name='[Calculation_1000000000000005]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Number of listings&quot; THEN COUNTD([id])&#13;&#10;WHEN &quot;Occupancy rate (%)&quot; THEN ROUND(AVG([Calculation_1000000000000001]) * 100, 1)&#13;&#10;WHEN &quot;Average rating&quot; THEN ROUND(AVG([review_scores_rating]), 2)&#13;&#10;WHEN &quot;Reviews, last 12 months&quot; THEN SUM([number_of_reviews_ltm])&#13;&#10;END' />
      </column>
